# RoboHarness Environment Configuration
# Copy to `.env` (gitignored) and populate values as needed.
# `RoboHarnessSettings.from_env()` auto-loads `.env` without overriding exported shell variables.

# Required for live Gemini 4 v1/v1beta API calls (not required for `--offline` tests/evals).
# `GOOGLE_API_KEY` is also accepted as a fallback.
GEMINI_API_KEY=

# Streamable HTTP MCP endpoint for the physical Hiwonder TonyPi daemon or local MuJoCo 4.0.1 Studio MCP server.
TONYPI_MCP_URL=http://127.0.0.1:8765/mcp

# Optional: publicly reachable/tunneled Streamable HTTP MCP URL exposed to the Managed Agent as `tonypi_mcp`
# when `--remote-mcp` is passed. Leave blank for local-only MCP execution.
TONYPI_REMOTE_MCP_URL=

# Optional: self-hosted Docker/MuJoCo sandbox environment ID for the Managed Agent Skill Forge.
# Leave blank to use hosted remote environment forking (`environment="remote"`).
GEMINI_ENVIRONMENT_ID=

# Optional: macOS AVFoundation webcam device index used by `roboharness mimic --webcam <seconds>`.
ROBOHARNESS_WEBCAM_DEVICE=0
